# Copy to subagents/.env and fill in. Never commit the real file.
DATABRICKS_API_BASE=
DATABRICKS_HOST=
DATABRICKS_API_KEY=
USER_ID=

# Serving quotas, per endpoint (from the Databricks Serving page).
DATABRICKS_ITPM_DATABRICKS_CLAUDE_OPUS_4_7=200000
DATABRICKS_OTPM_DATABRICKS_CLAUDE_OPUS_4_7=20000
DATABRICKS_RPM_DATABRICKS_CLAUDE_OPUS_4_7=6000
DATABRICKS_ITPM_DATABRICKS_CLAUDE_SONNET_4_6=200000
DATABRICKS_OTPM_DATABRICKS_CLAUDE_SONNET_4_6=20000
DATABRICKS_RPM_DATABRICKS_CLAUDE_SONNET_4_6=6000
